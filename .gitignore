# ============================================================================
# KeibaAI_v2 - Minimal Git Ignore Configuration
# ============================================================================
# Last Updated: 2025-11-24
#
# ポリシー: コード・ロジック・構造は全て公開、データ・モデルのみ除外
#
# 【Git管理対象（公開）】
#   ✓ 全てのPythonコード (.py)
#   ✓ 設定ファイル (.yaml, .json)
#   ✓ ドキュメント (.md, docs/)
#   ✓ テストコード (tests/)
#   ✓ スクリプト (scripts/)
#   ✓ ディレクトリ構造
#
# 【Git管理対象外（除外）】
#   ✗ データファイル (.parquet, .bin, .csv)
#   ✗ 訓練済みモデル (.pkl, .txt, .lgbm)
#   ✗ ログファイル (.log)
#   ✗ 実行時キャッシュ (__pycache__, .pyc)
#   ✗ 環境ファイル (venv/, .env)
#
# このポリシーにより、第三者がコードを読むだけでプロジェクト全体を
# 詳細に分析・推論できます。
# ============================================================================

# ============================================================================
# 1. Python実行時キャッシュ（必須除外）
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
*.so
*.dylib

# ============================================================================
# 2. 仮想環境（各開発者がローカルで作成）
# ============================================================================
.venv/
venv/
env/
ENV/
.env

# ============================================================================
# 3. データファイル（全て除外 - 大容量・個人情報含む）
# ============================================================================
# 注: ルート直下の data/ ディレクトリは削除済み（2025-11-24）
#     正規のデータは keibaai/data/ にのみ存在

# --- Phase 0: RAWデータ（スクレイピング結果 .bin） ---
keibaai/data/raw/

# --- Phase 1: パース済みデータ（.parquet） ---
keibaai/data/parsed/

# --- Phase 2: 特徴量データ（.parquet） ---
keibaai/data/features/

# --- キャッシュファイル（master/） ---
keibaai/data/master/

# --- スクレイピング補助ファイル（CSV, TXT） ---
kaisai_dates.csv
race_id_list.csv
horse_id_list.txt

# --- デバッグディレクトリ（削除済み: simulations_debug_*, evaluation） ---
keibaai/data/simulations_debug*/
keibaai/data/evaluation/

# ============================================================================
# 4. 訓練済みモデル（全て除外 - 再現可能）
# ============================================================================
# Phase 3: 訓練済みモデルファイル
keibaai/data/models/

# モデル形式全般
*.pkl
*.joblib
*.h5
*.hdf5
*.model
*.lgbm
*.onnx
*.pt
*.pth

# ============================================================================
# 5. 予測・シミュレーション・最適化結果（全て除外 - 再現可能）
# ============================================================================
# Phase 4: 予測結果
keibaai/data/predictions/

# Phase 5: シミュレーション結果
keibaai/data/simulations/

# Phase 6: 投資配分結果
keibaai/data/orders/

# ============================================================================
# 6. ログ・モニタリング・レポート（除外）
# ============================================================================
keibaai/data/logs/
keibaai/data/quality_reports/
keibaai/data/metrics/
keibaai/data/monitoring/
*.log

# ============================================================================
# 7. メタデータ・データベース（除外）
# ============================================================================
keibaai/data/metadata/
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal

# ============================================================================
# 8. デバッグ・一時ファイル（除外）
# ============================================================================
debug_output/
output_*/
**/output_*.csv
**/debug_*.csv
debug_scraped_data.csv
analysis_*.csv
analysis_*.txt
test_output_*.txt
verification_*.json
validate_*.json
keibaai/data/errors/

# scripts/temp/ の中身（README.md 以外）
scripts/temp/**/*.py
scripts/temp/**/*.csv
scripts/temp/**/*.txt
!scripts/temp/README.md

# ============================================================================
# 9. バックアップ・アーカイブファイル（除外）
# ============================================================================
*.bak
*.backup
*.old
*~
*.tar.gz
*.zip
*.rar
*.7z

# ============================================================================
# 10. IDE・エディタ設定（除外 - 個人設定）
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*.swn
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace
.spyderproject
.spyproject
.ropeproject

# ============================================================================
# 11. OS固有ファイル（除外）
# ============================================================================
.DS_Store
._*
Thumbs.db
Desktop.ini
*.lnk

# ============================================================================
# 12. テスト・カバレッジ（除外 - 実行結果）
# ============================================================================
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/

# ============================================================================
# 13. Jupyter Notebook checkpoints（除外）
# ============================================================================
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ============================================================================
# 14. Web スクレイピングツール バイナリ（除外）
# ============================================================================
chromedriver
chromedriver.exe
geckodriver
geckodriver.exe

# ============================================================================
# 15. その他のキャッシュ（除外）
# ============================================================================
.cache/
*.cache
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ============================================================================
# 16. ドキュメント生成成果物（除外 - ソースから再生成可能）
# ============================================================================
docs/_build/
/site

# ============================================================================
# 17. Node.js（将来的な可能性）
# ============================================================================
node_modules/

# ============================================================================
# END: プロジェクト分析に必要な最小限の除外設定
# ============================================================================
#
# 【重要】以下はGit管理対象（含まれる）:
#   - keibaai/src/**/*.py      （全てのソースコード）
#   - scripts/**/*.py          （全ての実行スクリプト）
#   - keibaai/configs/**/*.yaml（設定ファイル）
#   - docs/**/*.md             （ドキュメント）
#   - tests/**/*.py            （テストコード）
#   - CLAUDE.md, README.md     （ガイドドキュメント）
#   - requirements.txt         （依存関係）
#   - .gitignore, .gitattributes（Git設定）
#
# これらのファイルから、プロジェクトの全体像・ロジック・アルゴリズムを
# 完全に理解・再現できます。
# ============================================================================

.antigravity/
keibaai/models/_archive/
outputs/analysis/
outputs/reports/
scripts/_archive/
scripts/_archive_legacy/
scripts/training/_archive/
